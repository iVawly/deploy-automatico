# Domínio base e e-mail do ACME. Copie para .env e ajuste no servidor.
# Este arquivo não contém segredos e pode ser versionado.
DOMAIN=example.com
ACME_EMAIL=ops@example.com
DEPLOY_ROOT=/opt/deploy-platform
# Credenciais administrativas. O bootstrap cria os segredos do Swarm a partir
# destes valores quando eles ainda não existem. Proteja o arquivo: chmod 600 .env.
# Gere senhas fortes, por exemplo: openssl rand -base64 24
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Credenciais do dashboard do Traefik (o bootstrap gera o hash apr1).
TRAEFIK_ADMIN_USER=
TRAEFIK_ADMIN_PASSWORD=
