# Domínio base e e-mail do ACME. Copie para .env e ajuste no servidor.
# Este arquivo não contém segredos e pode ser versionado.
DOMAIN=example.com
ACME_EMAIL=ops@example.com
DEPLOY_ROOT=/opt/deploy-platform
# Usuário administrativo do Grafana. Defina um valor próprio; não use o padrão.
GRAFANA_ADMIN_USER=
# Credenciais do dashboard do Traefik, usadas ao criar o segredo traefik_dashboard_users.
TRAEFIK_ADMIN_USER=
TRAEFIK_ADMIN_PASSWORD=
