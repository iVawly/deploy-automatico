#!/usr/bin/env bash
# Test double for the docker CLI. Records invocations and simulates Swarm state.
set -u

: "${SHIM_LOG:?SHIM_LOG not set}"
: "${SHIM_STATE:?SHIM_STATE not set}"
mkdir -p "$SHIM_STATE/services"

printf 'docker %s\n' "$*" >>"$SHIM_LOG"

cmd="${1:-}"
shift || true

case "$cmd" in
  pull)
    exit 0
    ;;
  service)
    sub="${1:-}"
    shift || true
    case "$sub" in
      inspect)
        name=""
        format=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --format | -f) format="${2:-}"; shift 2 ;;
            *) name="$1"; shift ;;
          esac
        done
        [[ -n "$name" && -f "$SHIM_STATE/services/$name" ]] || exit 1
        if [[ "$format" == *Replicas* ]]; then
          if [[ -f "$SHIM_STATE/services/$name.replicas" ]]; then
            cat "$SHIM_STATE/services/$name.replicas"
          else
            printf '1'
          fi
        fi
        ;;
      create)
        if [[ "${1:-}" == "--help" ]]; then
          printf 'Options:\n'
          [[ "${SHIM_DOCKER_NO_SECURITY_OPT:-}" == "1" ]] || printf '      --security-opt list   Security options\n'
          exit 0
        fi
        [[ "${SHIM_DOCKER_FAIL_CREATE:-}" == "1" ]] && exit 1
        name=""
        image=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --name) name="$2"; shift 2 ;;
            --label | --container-label | --env | --secret | --mount | --network | --replicas | --update-order | --restart-condition | --security-opt | --cap-drop | --limit-memory | --limit-cpu | --limit-pids | --stop-grace-period | --log-driver | --log-opt) shift 2 ;;
            --detach | --quiet | --with-registry-auth | --init | --read-only) shift ;;
            *) image="$1"; shift ;;
          esac
        done
        [[ -n "$name" ]] || exit 1
        [[ -f "$SHIM_STATE/services/$name" ]] && exit 1
        if [[ "${SHIM_DOCKER_PARTIAL_CREATE:-}" == "1" && ! -f "$SHIM_STATE/partial-create-done" ]]; then
          printf '%s' "$image" >"$SHIM_STATE/services/$name"
          touch "$SHIM_STATE/partial-create-done"
          exit 1
        fi
        printf '%s' "$image" >"$SHIM_STATE/services/$name"
        ;;
      rm)
        for svc in "$@"; do
          [[ "${svc:-}" == --* ]] && continue
          rm -f "$SHIM_STATE/services/$svc" "$SHIM_STATE/services/$svc.replicas"
        done
        ;;
      update)
        name=""
        image=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --image) image="$2"; shift 2 ;;
            --env-add | --label-add) shift 2 ;;
            --quiet | --with-registry-auth | --force) shift ;;
            *) name="$1"; shift ;;
          esac
        done
        [[ -n "$name" ]] || exit 1
        [[ -f "$SHIM_STATE/services/$name" ]] || exit 1
        printf '%s' "$image" >"$SHIM_STATE/services/$name"
        ;;
      scale)
        while [[ "${1:-}" == --* ]]; do shift; done
        arg="${1:-}"
        svc="${arg%=*}"
        replicas="${arg##*=}"
        [[ -f "$SHIM_STATE/services/$svc" ]] || exit 1
        printf '%s' "$replicas" >"$SHIM_STATE/services/$svc.replicas"
        ;;
      ps)
        printf 'test-service  Running  \n'
        ;;
      ls)
        printf 'test-service 1/1 test-image\n'
        ;;
      *)
        exit 1
        ;;
    esac
    ;;
  network|secret)
    sub="${1:-}"
    shift || true
    [[ "$sub" == "inspect" ]] || exit 1
    name="${1:-}"
    [[ -n "$name" ]] || exit 1
    if [[ "$cmd" == "network" && "${SHIM_DOCKER_MISSING_NETWORK:-}" == "$name" ]]; then
      exit 1
    fi
    if [[ "$cmd" == "secret" ]]; then
      missing_secrets=()
      read -r -a missing_secrets <<< "${SHIM_DOCKER_MISSING_SECRETS:-}"
      for missing in "${missing_secrets[@]}"; do
        [[ "$name" == "$missing" ]] && exit 1
      done
    fi
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
