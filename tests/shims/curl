#!/usr/bin/env bash
# Test double for curl. Simulates health endpoints and the public route.
set -u

: "${SHIM_LOG:?SHIM_LOG not set}"
: "${SHIM_STATE:?SHIM_STATE not set}"
mkdir -p "$SHIM_STATE"

printf 'curl %s\n' "$*" >>"$SHIM_LOG"

if [[ -n "${SHIM_CURL_FORCE_TIMEOUT:-}" ]]; then
  exit 28
fi

url=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -H) shift 2 ;;
    --max-time | -o | -w) shift 2 ;;
    -sS) shift ;;
    *) url="$1"; shift ;;
  esac
done

health_version="$(cat "$SHIM_STATE/health-version" 2>/dev/null || printf 'test')"
body="{\"status\":\"healthy\",\"version\":\"$health_version\"}"
code=200

if [[ "$url" == *"app-"*"-blue"* || "$url" == *"app-"*"-green"* ]]; then
  slot="blue"
  [[ "$url" == *"green"* ]] && slot="green"
  if grep -Fxq "$slot" "$SHIM_STATE/unhealthy" 2>/dev/null; then
    body='{"status":"unhealthy","checks":[{"name":"db","status":"down"}]}'
    code=503
  fi
  if [[ -f "$SHIM_STATE/weird-health-body" ]]; then
    body="$(cat "$SHIM_STATE/weird-health-body")"
    code=200
  fi
else
  host="${url#*://}"
  host="${host%%/*}"
  host="${host%%:*}"
  route=""
  for candidate in "${OPS_DEPLOY_DYNAMIC_DIR:-}"/*.yml; do
    [[ -f "$candidate" ]] || continue
    if grep -Fq "Host(\`$host\`)" "$candidate"; then
      route="$candidate"
    fi
  done
  if [[ -n "$route" ]]; then
    version="$(sed -n 's/^# .*version=\([^ ]*\).*/\1/p' "$route" | head -n 1)"
    [[ -f "$SHIM_STATE/public-version" ]] && version="$(cat "$SHIM_STATE/public-version")"
    if [[ -f "$SHIM_STATE/public-stale-for-version" ]] \
      && [[ "$version" == "$(cat "$SHIM_STATE/public-stale-for-version")" ]]; then
      version="$(cat "$SHIM_STATE/public-stale-version" 2>/dev/null || printf 'stale')"
    fi
    fail=0
    [[ -f "$SHIM_STATE/public-fail" ]] && fail=1
    if [[ -f "$SHIM_STATE/public-fail-version" ]] \
      && [[ "$version" == "$(cat "$SHIM_STATE/public-fail-version")" ]]; then
      fail=1
    fi
    if [[ "$fail" == "1" ]]; then
      body='{"message":"bad gateway"}'
      code=502
    else
      body="{\"service\":\"$host\",\"version\":\"$version\"}"
      code=200
    fi
  else
    code=404
    body='{"message":"not found"}'
  fi
fi

printf '%s\n%s' "$body" "$code"
